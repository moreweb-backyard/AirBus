<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#cccccc"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textView17"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  subnetID:  "
        android:layout_alignBottom="@+id/othersubed"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textView20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="deviceID:"
        android:layout_toLeftOf="@+id/othersubed"
        android:layout_below="@+id/textView17"
        android:layout_alignBottom="@+id/otherdeved"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@+id/othersubed"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textView21"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="channel_1:"
        android:layout_toLeftOf="@+id/otherdeved"
        android:layout_below="@+id/textView20"
        android:layout_alignBottom="@+id/otherchan1ed"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@+id/otherdeved"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textView22"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="name:"
        android:layout_above="@+id/textView23"
        android:layout_below="@+id/textView24"
        android:layout_alignRight="@+id/textView24"
        android:layout_alignParentLeft="true"
        android:layout_alignEnd="@+id/textView24"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textView23"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="icon"
        android:layout_toLeftOf="@+id/othernameed"
        android:layout_alignTop="@+id/imageView11"
        android:layout_alignBottom="@+id/imageView11"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@+id/othernameed"
        android:layout_alignParentStart="true"/>
    <EditText
        android:textColor="#000000"
        android:id="@+id/othersubed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_toRightOf="@+id/textView17"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:inputType="number"
        android:layout_toEndOf="@+id/textView17"
        android:layout_alignParentEnd="true"/>
    <EditText
        android:textColor="#000000"
        android:id="@+id/otherdeved"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_toRightOf="@+id/textView20"
        android:layout_below="@+id/othersubed"
        android:layout_alignParentRight="true"
        android:inputType="number"
        android:layout_toEndOf="@+id/textView20"
        android:layout_alignParentEnd="true"/>
    <EditText
        android:textColor="#000000"
        android:id="@+id/otherchan1ed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Channel No/Dry Connector NO"
        android:ems="10"
        android:layout_toRightOf="@+id/textView20"
        android:layout_below="@+id/textView20"
        android:layout_alignParentRight="true"
        android:inputType="number"
        android:layout_toEndOf="@+id/textView20"
        android:layout_alignParentEnd="true"/>
    <EditText
        android:textColor="#000000"
        android:id="@+id/othernameed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/textView22"
        android:layout_below="@+id/otherchan2ed"
        android:layout_alignParentRight="true"
        android:layout_toEndOf="@+id/textView22"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_toRightOf="@+id/textView22"
        android:layout_below="@+id/othernameed"
        android:layout_toEndOf="@+id/textView22"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textView24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="channel_2:"
        android:layout_toLeftOf="@+id/otherchan1ed"
        android:layout_below="@+id/textView21"
        android:layout_alignBottom="@+id/otherchan2ed"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@+id/otherchan1ed"
        android:layout_alignParentStart="true"/>
    <EditText
        android:textColor="#000000"
        android:id="@+id/otherchan2ed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_toRightOf="@+id/textView24"
        android:layout_below="@+id/otherchan1ed"
        android:layout_alignParentRight="true"
        android:inputType="number"
        android:layout_toEndOf="@+id/textView24"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
