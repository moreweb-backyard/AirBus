<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/bg_style">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        style="@style/top_bg_style">
        <Button
            android:textSize="@dimen/text_title_size"
            android:textColor="@color/color_white"
            android:id="@+id/back"
            android:background="@drawable/btn_back_selector"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="60dp"
            android:layout_height="35dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/back"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_camera_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/others"
            android:shadowColor="@color/color_shadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/background_white_corner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="5dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/others_setting_currentinfo"
                android:layout_alignParentLeft="true"/>
        </RelativeLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:src="@color/color_grey"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/linearLayout1"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_margin="5dp">
            <TextView
                android:textColor="@color/color_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_version"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textColor="@color/color_black"
                android:id="@+id/sysver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/issysnew"
                android:background="@drawable/have_new"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/sysver"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/imageView1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:src="@color/color_grey"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/linearLayout2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_margin="5dp">
            <TextView
                android:textColor="@color/color_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/others_local_appver"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textColor="@color/color_black"
                android:id="@+id/appver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/isappnew"
                android:background="@drawable/have_new"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/appver"/>
        </RelativeLayout>
        <ImageView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:src="@color/color_grey"/>
        <LinearLayout
            android:id="@+id/linearLayout1"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btn_checkupdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/others_check_update"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/background_white_corner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="5dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/others_setting_servernewinfo"
                android:layout_alignParentLeft="true"/>
        </RelativeLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:src="@color/color_grey"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/service_sysver"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_margin="5dp">
            <TextView
                android:textColor="@color/color_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_version"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textColor="@color/color_black"
                android:id="@+id/service_sysver_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/imageView1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:src="@color/color_grey"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/service_app"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_margin="5dp">
            <TextView
                android:textColor="@color/color_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="最新界面固件:"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textColor="@color/color_black"
                android:id="@+id/service_appver_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <ImageView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:src="@color/color_grey"/>
    </LinearLayout>
</LinearLayout>
