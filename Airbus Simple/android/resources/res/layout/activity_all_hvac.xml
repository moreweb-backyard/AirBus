<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/allhvacout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hvac_page_bg"
        android:scaleType="centerCrop"/>
    <android.support.v7.widget.Toolbar
        android:id="@+id/allhvac_toolbar"
        android:background="#5f000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        style="@style/MenuStyle"/>
    <RelativeLayout
        android:id="@+id/relativeLayout7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/allhvac_toolbar"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
        <com.shima.smartbushome.assist.WheelView
            android:id="@+id/hvacroomchoose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/allhvacselectroom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="Select Room:"
        android:layout_below="@+id/relativeLayout7"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <Space
        android:id="@+id/space6"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <Button
        android:textColor="#ffffff"
        android:id="@+id/button14"
        android:background="@drawable/control_back_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        android:text="ALL AC On"
        android:layout_toLeftOf="@+id/space6"
        android:layout_below="@+id/allhvacselectroom"
        android:layout_alignParentLeft="true"
        android:onClick="allacon"
        android:layout_alignParentStart="true"/>
    <Button
        android:textColor="#ffffff"
        android:id="@+id/button15"
        android:background="@drawable/control_back_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:text="All AC off"
        android:layout_toRightOf="@+id/space6"
        android:layout_alignTop="@+id/button14"
        android:layout_alignParentRight="true"
        android:onClick="allacoff"
        android:layout_alignParentEnd="true"/>
    <Button
        android:textColor="#ffffff"
        android:id="@+id/button16"
        android:background="@drawable/control_back_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="cool"
        android:layout_below="@+id/button14"
        android:layout_alignLeft="@+id/button14"
        android:layout_alignRight="@+id/button14"
        android:onClick="allaccool"
        android:layout_alignStart="@+id/button14"
        android:layout_alignEnd="@+id/button14"/>
    <Button
        android:textColor="#ffffff"
        android:id="@+id/button17"
        android:background="@drawable/control_back_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="heat"
        android:layout_below="@+id/button15"
        android:layout_alignLeft="@+id/button15"
        android:layout_alignRight="@+id/button15"
        android:onClick="allacheat"
        android:layout_alignStart="@+id/button15"
        android:layout_alignEnd="@+id/button15"/>
    <Button
        android:textColor="#ffffff"
        android:id="@+id/button18"
        android:background="@drawable/control_back_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="fan"
        android:layout_below="@+id/button16"
        android:layout_alignLeft="@+id/button16"
        android:layout_alignRight="@+id/button16"
        android:onClick="allacfan"
        android:layout_alignStart="@+id/button16"
        android:layout_alignEnd="@+id/button16"/>
    <Button
        android:textColor="#ffffff"
        android:id="@+id/button19"
        android:background="@drawable/control_back_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginRight="10dp"
        android:text="auto"
        android:layout_below="@+id/button17"
        android:layout_alignLeft="@+id/button17"
        android:layout_alignParentRight="true"
        android:onClick="allacauto"
        android:layout_alignStart="@+id/button17"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
