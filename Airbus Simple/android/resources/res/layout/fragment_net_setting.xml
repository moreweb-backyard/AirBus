<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="#5297ff"
                android:id="@+id/tv_g4server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G4 Server Website or IP address"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"/>
            <EditText
                android:id="@+id/et_realm"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:hint="smartbuscloud.com/74.208.144.185"
                android:layout_below="@+id/tv_g4server"
                android:layout_alignLeft="@+id/ms_ns_save"
                android:layout_alignRight="@+id/ms_ns_save"
                android:layout_alignStart="@+id/ms_ns_save"
                android:layout_alignEnd="@+id/ms_ns_save"/>
            <Button
                android:textColor="#5297ff"
                android:id="@+id/bt_g4_server_save"
                android:background="@drawable/media_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:text="save"
                android:layout_below="@+id/et_realm"
                android:layout_alignRight="@+id/ms_ns_etpassword"
                android:layout_alignParentLeft="true"
                android:layout_alignEnd="@+id/ms_ns_etpassword"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="#5297ff"
                android:id="@+id/textView84"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" NetSetting"
                android:layout_below="@+id/bt_g4_server_save"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"/>
            <EditText
                android:id="@+id/ms_ns_etname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:hint="User Name"
                android:ems="10"
                android:layout_below="@+id/textView84"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:inputType="textPersonName"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"/>
            <EditText
                android:id="@+id/ms_ns_etpassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:hint="Password"
                android:layout_below="@+id/ms_ns_etname"
                android:layout_alignLeft="@+id/ms_ns_etname"
                android:layout_alignParentRight="true"
                android:inputType="textVisiblePassword"
                android:layout_alignStart="@+id/ms_ns_etname"
                android:layout_alignParentEnd="true"/>
            <Button
                android:textColor="#001eff"
                android:id="@+id/ms_ns_login"
                android:background="@drawable/media_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="2dp"
                android:text="login"
                android:layout_below="@+id/ms_ns_etpassword"
                android:layout_alignLeft="@+id/textView87"
                android:layout_alignStart="@+id/textView87"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textView87"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Select RS/IP:"
                android:layout_below="@+id/ms_ns_login"
                android:layout_alignLeft="@+id/ms_ns_cb"
                android:layout_alignStart="@+id/ms_ns_cb"/>
            <Button
                android:textColor="#5297ff"
                android:id="@+id/ms_ns_save"
                android:background="@drawable/media_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:text="save settings"
                android:layout_below="@+id/ms_ns_cb"
                android:layout_alignRight="@+id/ms_ns_etpassword"
                android:layout_alignParentLeft="true"
                android:layout_alignEnd="@+id/ms_ns_etpassword"
                android:layout_alignParentStart="true"/>
            <CheckBox
                android:id="@+id/ms_ns_cb"
                android:background="@drawable/media_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:checked="false"
                android:text="use smart G4 server"
                android:layout_below="@+id/ms_ns_select"
                android:layout_alignLeft="@+id/ms_ns_save"
                android:layout_alignRight="@+id/ms_ns_save"
                android:layout_alignStart="@+id/ms_ns_save"
                android:layout_alignEnd="@+id/ms_ns_save"/>
            <Button
                android:textColor="#5297ff"
                android:id="@+id/ms_ns_select"
                android:background="@drawable/media_back"
                android:paddingLeft="10dp"
                android:paddingRight="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_toRightOf="@+id/textView87"
                android:layout_below="@+id/ms_ns_login"
                android:layout_toEndOf="@+id/textView87"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="#5297ff"
                android:gravity="center_vertical"
                android:id="@+id/ms_ns_wifinametext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Remember your current wifi:"
                android:layout_below="@+id/textView110"
                android:layout_alignLeft="@+id/ms_ns_save"
                android:layout_alignRight="@+id/ms_ns_etpassword"
                android:layout_alignStart="@+id/ms_ns_save"
                android:layout_alignEnd="@+id/ms_ns_etpassword"/>
            <Button
                android:textColor="#5297ff"
                android:id="@+id/ms_ns_savewifiname"
                android:background="@drawable/media_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="save"
                android:layout_toLeftOf="@+id/space19"
                android:layout_below="@+id/ms_ns_wifinametext"
                android:layout_alignLeft="@+id/ms_ns_etname"
                android:layout_alignStart="@+id/ms_ns_etname"
                style="?android:attr/buttonStyleSmall"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textView110"
                android:background="#979797"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/ms_ns_save"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"/>
            <Button
                android:textColor="#5297ff"
                android:id="@+id/ms_ns_deletewifiname"
                android:background="@drawable/media_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="delete"
                android:layout_toRightOf="@+id/space19"
                android:layout_alignTop="@+id/ms_ns_savewifiname"
                android:layout_alignRight="@+id/ms_ns_wifinametext"
                android:layout_alignEnd="@+id/ms_ns_wifinametext"
                style="?android:attr/buttonStyleSmall"/>
            <Space
                android:id="@+id/space19"
                android:layout_width="20px"
                android:layout_height="20px"
                android:layout_marginBottom="61dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <Button
                android:textColor="#ff0000"
                android:id="@+id/bt_modifypassword"
                android:background="@drawable/media_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="modify password"
                android:layout_below="@+id/ms_ns_etpassword"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"/>
            <Button
                android:textColor="#ff0000"
                android:id="@+id/ms_ns_logout"
                android:background="@drawable/media_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="19dp"
                android:text="logout"
                android:layout_below="@+id/ms_ns_etpassword"
                android:layout_alignLeft="@+id/ms_ns_select"
                android:layout_marginStart="19dp"
                android:layout_alignStart="@+id/ms_ns_select"/>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
