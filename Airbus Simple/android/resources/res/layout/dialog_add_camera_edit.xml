<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Add Camera"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:visibility="gone"
            style="@style/wrap_layout">
            <LinearLayout
                android:padding="0dp"
                android:layout_height="50dp"
                style="@style/single_layout">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="-30dp"
                    android:text="add_device"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/wrap_layout">
            <LinearLayout
                android:padding="0dp"
                android:layout_height="50dp"
                style="@style/single_layout">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Camera Name"
                    android:layout_weight="2"/>
                <View
                    android:background="#ccc"
                    android:layout_width="0.3dp"
                    android:layout_height="match_parent"/>
                <EditText
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/et_name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:visibility="gone"
            style="@style/wrap_layout">
            <LinearLayout
                android:padding="0dp"
                android:layout_height="50dp"
                style="@style/single_layout">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="-30dp"
                    android:text="add_device"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/wrap_layout">
            <LinearLayout
                android:padding="0dp"
                android:layout_height="50dp"
                style="@style/single_layout">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Camera ID"
                    android:layout_weight="2"/>
                <View
                    android:background="#ccc"
                    android:layout_width="0.3dp"
                    android:layout_height="match_parent"/>
                <EditText
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/et_id"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:visibility="gone"
            style="@style/wrap_layout">
            <LinearLayout
                android:padding="0dp"
                android:layout_height="50dp"
                style="@style/single_layout">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="-30dp"
                    android:text="add_device"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/wrap_layout">
            <LinearLayout
                android:padding="0dp"
                android:layout_height="50dp"
                style="@style/single_layout">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:layout_weight="2"/>
                <View
                    android:background="#ccc"
                    android:layout_width="0.3dp"
                    android:layout_height="match_parent"/>
                <EditText
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/et_username"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:visibility="gone"
            style="@style/wrap_layout">
            <LinearLayout
                android:padding="0dp"
                android:layout_height="50dp"
                style="@style/single_layout">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="-30dp"
                    android:text="add_device"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/wrap_layout">
            <LinearLayout
                android:padding="0dp"
                android:layout_height="50dp"
                style="@style/single_layout">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:layout_weight="2"/>
                <View
                    android:background="#ccc"
                    android:layout_width="0.3dp"
                    android:layout_height="match_parent"/>
                <EditText
                    android:textColor="#000000"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/et_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="10dp">
        <FrameLayout
            android:id="@+id/fl_dialog_no"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/single_layout">
            <ImageView
                android:gravity="center"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@null"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#232323"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-2dp"
                android:text="Cancel"/>
        </FrameLayout>
        <View
            android:layout_width="20dp"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/fl_dialog_delete"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/single_layout">
            <ImageView
                android:gravity="center"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@null"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#232323"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-2dp"
                android:text="Delete"/>
        </FrameLayout>
        <View
            android:layout_width="20dp"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/fl_dialog_yes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/single_layout">
            <ImageView
                android:gravity="center"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@null"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#232323"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-2dp"
                android:text="Confirm"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
