<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/notice_view_type_0"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:id="@+id/textView25"
        android:layout_width="5dp"
        android:layout_height="64dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/imageView12"
        android:background="@mipmap/ic_launcher"
        android:layout_width="55dp"
        android:layout_height="55dp"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:id="@+id/textView26"
        android:layout_width="5dp"
        android:layout_height="64dp"/>
    <TextView
        android:textColor="#a9a9a9"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/music_notify_songname"
        android:layout_width="80dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:textAlignment="center"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <ImageView
            android:id="@+id/close_iv"
            android:background="@drawable/music_notify_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentRight="true"/>
        <Button
            android:id="@+id/music_notify_back"
            android:background="@drawable/notify_music_back"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <Button
            android:gravity="center"
            android:id="@+id/music_notify_next"
            android:background="@drawable/notify_music_next"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_toRightOf="@+id/music_notify_play"
            android:layout_alignTop="@+id/music_notify_play"
            android:layout_toEndOf="@+id/music_notify_play"/>
        <ImageView
            android:id="@+id/music_notify_play"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_toRightOf="@+id/music_notify_back"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/music_notify_back"/>
    </RelativeLayout>
</LinearLayout>
