<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <com.shima.smartbushome.assist.SwipeLayout
            android:orientation="horizontal"
            android:id="@+id/fantype1swipe"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:minHeight="?android:attr/listPreferredItemHeight">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/fantype1linear"
                android:layout_width="match_parent"
                android:layout_height="80dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/fanshowpopup"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2">
                    <ImageView
                        android:id="@+id/fantype1_img"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.5"/>
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="15dp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/fantype1_name"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="fan name"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5">
                    <ImageView
                        android:id="@+id/imageView20"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="5dp"
                        android:src="@mipmap/fanremark"
                        android:scaleType="centerInside"
                        android:layout_weight="1"/>
                    <SeekBar
                        android:id="@+id/fantype1seekbar"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:max="4"
                        android:indeterminate="false"
                        android:layout_weight="1.5"/>
                </LinearLayout>
                <CheckBox
                    android:id="@+id/fantype1_cb"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:checked="false"
                    android:button="@drawable/checkbox_checked_style"
                    android:layout_weight="0.7"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="#d20001"
                android:layout_width="60dp"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/fantype1_delete"
                    android:layout_width="60dp"
                    android:layout_height="match_parent">
                    <ImageView
                        android:background="@drawable/ic_delete"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_centerInParent="true"/>
                </LinearLayout>
            </LinearLayout>
        </com.shima.smartbushome.assist.SwipeLayout>
    </LinearLayout>
</merge>
