<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <com.shima.smartbushome.assist.SwipeLayout
            android:orientation="horizontal"
            android:id="@+id/othertype2swipe"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:minHeight="?android:attr/listPreferredItemHeight">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/othertype2linear"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/othertype2imageView"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1.5"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/othertype2rmark"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:text="other"
                    android:layout_weight="1.3"
                    android:textAlignment="center"/>
                <Space
                    android:id="@+id/sp"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="0.2"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/othertype2state"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:text="unknown"
                    android:layout_weight="1.3"
                    android:textAlignment="center"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.1">
                    <Button
                        android:textSize="8dp"
                        android:textColor="#000000"
                        android:gravity="bottom|center_horizontal"
                        android:layout_gravity="center"
                        android:id="@+id/othertype2on"
                        android:background="@mipmap/curtain_open"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="2dp"
                        android:maxHeight="50dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.1">
                    <Button
                        android:textSize="8dp"
                        android:textColor="#000000"
                        android:gravity="bottom|center_horizontal"
                        android:layout_gravity="center"
                        android:id="@+id/othertype2stop"
                        android:background="@mipmap/curtain_stop"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:maxHeight="50dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.1">
                    <Button
                        android:textSize="8dp"
                        android:textColor="#000000"
                        android:gravity="bottom|center_horizontal"
                        android:layout_gravity="center"
                        android:id="@+id/othertype2off"
                        android:background="@mipmap/curtain_close"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginRight="2dp"
                        android:maxHeight="50dp"/>
                </LinearLayout>
                <CheckBox
                    android:id="@+id/othertype2delete"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:checked="false"
                    android:button="@drawable/checkbox_checked_style"
                    android:layout_weight="0.7"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="#d20001"
                android:layout_width="60dp"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/othertype2_delete"
                    android:layout_width="60dp"
                    android:layout_height="match_parent">
                    <ImageView
                        android:background="@drawable/ic_delete"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_centerInParent="true"/>
                </LinearLayout>
            </LinearLayout>
        </com.shima.smartbushome.assist.SwipeLayout>
    </LinearLayout>
</merge>
