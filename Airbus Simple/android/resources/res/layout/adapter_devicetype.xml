<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="18dp"
        android:id="@+id/devicetype_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="name"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="15dp"
        android:id="@+id/sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="subnetID:"
        android:layout_toLeftOf="@+id/space"
        android:layout_below="@+id/devicetype_name"
        android:layout_alignParentLeft="true"
        android:textIsSelectable="false"
        android:layout_toStartOf="@+id/space"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="15dp"
        android:id="@+id/dev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="deviceID:"
        android:layout_toRightOf="@+id/space"
        android:layout_below="@+id/devicetype_name"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="#000000"
        android:layout_width="wrap_content"
        android:layout_height="0.5dp"
        android:layout_alignRight="@+id/dev"
        android:layout_alignBottom="@+id/sub"
        android:layout_alignEnd="@+id/dev"/>
    <Space
        android:id="@+id/space"
        android:layout_width="20px"
        android:layout_height="20px"
        android:layout_alignBottom="@+id/dev"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
