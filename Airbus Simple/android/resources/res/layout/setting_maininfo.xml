<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-50dp">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center"
            android:id="@+id/textView16"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="10dp"
            android:text="BackgroundColor:"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/mainbgcolor"
            android:background="#000000"
            android:visibility="invisible"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:layout_toRightOf="@+id/textView16"
            android:layout_alignBottom="@+id/textView16"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@+id/textView16"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center"
            android:id="@+id/textView18"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Icon:"
            android:layout_toLeftOf="@+id/mainbgcolor"
            android:layout_below="@+id/textView16"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@+id/mainbgcolor"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center"
            android:id="@+id/textView19"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Name:"
            android:layout_below="@+id/textView18"
            android:layout_alignRight="@+id/textView18"
            android:layout_alignParentLeft="true"
            android:layout_alignEnd="@+id/textView18"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/mainroomicon"
            android:background="#000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView16"
            android:layout_alignLeft="@+id/mainbgcolor"
            android:layout_alignRight="@+id/mainbgcolor"
            android:layout_alignBottom="@+id/textView18"
            android:layout_alignStart="@+id/mainbgcolor"
            android:layout_alignEnd="@+id/mainbgcolor"/>
        <EditText
            android:textColor="#000000"
            android:id="@+id/mainnameeditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/textView18"
            android:layout_below="@+id/mainroomicon"
            android:layout_alignParentRight="true"
            android:layout_toEndOf="@+id/textView16"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
