<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="140dp">
        <RelativeLayout
            android:id="@+id/nfc_selflayout"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="10dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/nfclinear"
                android:layout_width="match_parent"
                android:layout_height="120dp">
                <TextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/nfc_name"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:text="call911"
                    android:layout_weight="1.2"/>
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/nfc_detail"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1.2"
                    android:textAlignment="center"/>
                <Switch
                    android:layout_gravity="center"
                    android:id="@+id/nfc_switch"
                    android:paddingRight="15dp"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:checked="false"
                    android:layout_weight="0.8"/>
                <CheckBox
                    android:id="@+id/nfc_delete"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:checked="false"
                    android:button="@drawable/checkbox_checked_style"
                    android:layout_weight="0.5"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</merge>
