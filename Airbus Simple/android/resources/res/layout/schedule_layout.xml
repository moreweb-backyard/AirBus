<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="140dp">
        <RelativeLayout
            android:id="@+id/schedule_selflayout"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="10dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/shcedulelinear"
                android:layout_width="match_parent"
                android:layout_height="90dp">
                <TextView
                    android:textSize="40dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/schedule_time"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:text="17:56"
                    android:layout_weight="1.2"/>
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/schedule_name"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1.2"
                    android:textAlignment="center"/>
                <com.kyleduo.switchbutton.SwitchButton
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/schedule_switch"
                    android:paddingLeft="10dp"
                    android:paddingTop="40dp"
                    android:paddingRight="15dp"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:checked="false"
                    android:layout_weight="0.8"
                    app:kswAnimationDuration="300"
                    app:kswBackDrawable="@drawable/ios_back_drawable"
                    app:kswBackMeasureRatio="1.4"
                    app:kswThumbDrawable="@drawable/ios_thumb_selector"
                    app:kswThumbMarginBottom="-8dp"
                    app:kswThumbMarginLeft="-5dp"
                    app:kswThumbMarginRight="-5dp"
                    app:kswThumbMarginTop="-2.5dp"/>
                <CheckBox
                    android:id="@+id/schedule_delete"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:checked="false"
                    android:button="@drawable/checkbox_checked_style"
                    android:layout_weight="0.5"/>
            </LinearLayout>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#f1f1f1"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/schedule_state"
                android:paddingLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_weight="1.3"
                android:layout_below="@+id/shcedulelinear"/>
        </RelativeLayout>
    </LinearLayout>
</merge>
