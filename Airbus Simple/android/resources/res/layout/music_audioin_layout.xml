<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1">
        <ImageView
            android:id="@+id/imageView4"
            android:background="@drawable/music_audioin"
            android:padding="10dp"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginTop="20dp"
            android:src="@mipmap/audioin"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <SeekBar
            android:id="@+id/seekBar3"
            android:background="@drawable/media_back"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_toRightOf="@+id/checkBox4"
            android:layout_alignBottom="@+id/checkBox4"
            android:layout_toEndOf="@+id/checkBox4"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/textView4"
            android:background="@drawable/media_back"
            android:paddingLeft="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:text="0%"
            android:layout_toLeftOf="@+id/checkBox4"
            android:layout_alignTop="@+id/seekBar3"
            android:layout_alignBottom="@+id/checkBox4"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@+id/checkBox4"
            android:layout_alignParentStart="true"/>
        <Button
            android:id="@+id/checkBox4"
            android:background="@drawable/play"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="5dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</merge>
