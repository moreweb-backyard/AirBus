<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/on"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="100dp"
                android:text="ON"
                android:layout_toLeftOf="@+id/space4"
                android:layout_below="@+id/hvacremark"
                android:layout_alignParentLeft="true"
                android:layout_toStartOf="@+id/space4"
                android:layout_alignParentStart="true"/>
            <Button
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/off"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:layout_marginRight="20dp"
                android:text="OFF"
                android:layout_toRightOf="@+id/space4"
                android:layout_alignTop="@+id/on"
                android:layout_alignBottom="@+id/on"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/space4"
                android:layout_alignParentEnd="true"/>
            <Button
                android:textSize="50dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/down"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:text="—"
                android:layout_below="@+id/on"
                android:layout_alignLeft="@+id/on"
                android:textAlignment="center"
                android:layout_alignStart="@+id/on"/>
            <Button
                android:textSize="50dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/up"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:text="+"
                android:layout_below="@+id/off"
                android:layout_alignRight="@+id/off"
                android:textAlignment="center"
                android:layout_alignEnd="@+id/off"/>
            <TextView
                android:id="@+id/textView67"
                android:background="#bfbfbf"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/down"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/autofan"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="AUTO"
                android:layout_below="@+id/mediumfan"
                android:layout_alignLeft="@+id/mediumfan"
                android:layout_alignStart="@+id/mediumfan"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/highfan"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="40dp"
                android:text="High"
                android:layout_below="@+id/down"
                android:layout_alignLeft="@+id/down"
                android:layout_alignStart="@+id/down"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/mediumfan"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="20dp"
                android:text="Medium"
                android:layout_below="@+id/up"
                android:layout_alignRight="@+id/up"
                android:layout_alignEnd="@+id/up"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/lowfan"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="Low"
                android:layout_below="@+id/highfan"
                android:layout_alignLeft="@+id/highfan"
                android:layout_alignStart="@+id/highfan"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/automode"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="AUTO"
                android:layout_below="@+id/heat"
                android:layout_alignLeft="@+id/heat"
                android:layout_alignStart="@+id/heat"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/cool"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:text="Cool"
                android:layout_below="@+id/lowfan"
                android:layout_alignLeft="@+id/lowfan"
                android:layout_alignStart="@+id/lowfan"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/heat"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:text="Heat"
                android:layout_above="@+id/fan"
                android:layout_alignLeft="@+id/autofan"
                android:layout_alignStart="@+id/autofan"/>
            <Button
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:id="@+id/fan"
                android:background="@drawable/control_back_10"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="fan"
                android:layout_below="@+id/cool"
                android:layout_alignLeft="@+id/cool"
                android:layout_alignStart="@+id/cool"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/fanstate"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDIUM"
                android:layout_below="@+id/mediumfan"
                android:layout_centerHorizontal="true"
                android:textAlignment="center"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/mode"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO"
                android:layout_below="@+id/heat"
                android:layout_centerHorizontal="true"
                android:textAlignment="center"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="30sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/hvacremark"
                android:paddingLeft="5dp"
                android:paddingTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AC:  "
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:textIsSelectable="false"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_curtemper"
                android:background="@drawable/control_back_10"
                android:layout_width="200dp"
                android:layout_height="80dp"
                android:layout_marginTop="50dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/ac_home"/>
                <TextView
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/tv_curtemper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="--"
                    android:textAlignment="center"/>
            </LinearLayout>
            <Space
                android:id="@+id/space4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:id="@+id/textView27"
                android:background="#bfbfbf"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/lowfan"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="30dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/textView68"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE"
                android:layout_alignTop="@+id/textView27"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="30dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/textView66"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAN"
                android:layout_alignTop="@+id/textView67"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/textView67"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="50dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/temp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/uint"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="-10dp"
                    android:text="℃"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</merge>
