<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <com.shima.smartbushome.assist.SwipeLayout
            android:orientation="horizontal"
            android:id="@+id/othertype1swipe"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:minHeight="?android:attr/listPreferredItemHeight">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/othertype1linear"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/othertype1imageView"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1.5"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/othertype1remark"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:text="other"
                    android:layout_weight="1.3"
                    android:textAlignment="center"/>
                <Space
                    android:id="@+id/onofftype1sp"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="0.2"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/othertype1state"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:text="unknown"
                    android:layout_weight="1.3"
                    android:textAlignment="center"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1.4">
                    <Button
                        android:textColor="#ff000000"
                        android:gravity="bottom|center_horizontal"
                        android:layout_gravity="center"
                        android:id="@+id/othertype1on"
                        android:background="@mipmap/other_on"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginLeft="2dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1.4">
                    <Button
                        android:textColor="#ff000000"
                        android:gravity="bottom|center_horizontal"
                        android:layout_gravity="center"
                        android:id="@+id/othertype1off"
                        android:background="@mipmap/other_off"
                        android:layout_width="60dp"
                        android:layout_height="60dp"/>
                </LinearLayout>
                <Space
                    android:id="@+id/onofftype1sp2"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="0.5"/>
                <CheckBox
                    android:id="@+id/othertype1checkBox"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:checked="false"
                    android:button="@drawable/checkbox_checked_style"
                    android:layout_weight="0.7"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="#d20001"
                android:layout_width="60dp"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/othertype1_delete"
                    android:layout_width="60dp"
                    android:layout_height="match_parent">
                    <ImageView
                        android:background="@drawable/ic_delete"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_centerInParent="true"/>
                </LinearLayout>
            </LinearLayout>
        </com.shima.smartbushome.assist.SwipeLayout>
    </LinearLayout>
</merge>
