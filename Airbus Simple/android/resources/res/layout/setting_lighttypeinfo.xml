<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textView37"
        android:paddingLeft="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="subnetID:"
        android:layout_alignBottom="@+id/lededitTextsub"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textView38"
        android:paddingLeft="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="deviceID:"
        android:layout_below="@+id/textView37"
        android:layout_alignBottom="@+id/lededitText2dev"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/textView39"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="name:"
        android:layout_below="@+id/lededitText2dev"
        android:layout_alignRight="@+id/textView38"
        android:layout_alignBottom="@+id/lededitTextname"
        android:layout_alignParentLeft="true"
        android:layout_alignEnd="@+id/textView38"
        android:layout_alignParentStart="true"/>
    <EditText
        android:textColor="#000000"
        android:id="@+id/lededitTextsub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_toRightOf="@+id/textView37"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:inputType="number"
        android:layout_toEndOf="@+id/textView37"
        android:layout_alignParentEnd="true"/>
    <EditText
        android:textColor="#000000"
        android:id="@+id/lededitText2dev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_below="@+id/lededitTextsub"
        android:layout_alignLeft="@+id/lededitTextname"
        android:layout_alignParentRight="true"
        android:inputType="number"
        android:layout_alignStart="@+id/lededitTextname"
        android:layout_alignParentEnd="true"/>
    <EditText
        android:textColor="#000000"
        android:id="@+id/lededitTextname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/textView37"
        android:layout_below="@+id/lededitText2dev"
        android:layout_alignParentRight="true"
        android:layout_toEndOf="@+id/textView37"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:id="@+id/textView90"
        android:paddingLeft="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="lightType:"
        android:layout_below="@+id/textView39"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <HorizontalScrollView
        android:id="@+id/horizontalScrollView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/textView90"
        android:layout_alignTop="@+id/textView90"
        android:layout_alignParentRight="true"
        android:layout_toEndOf="@+id/textView37"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioGroup
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/textView90"
                android:layout_alignTop="@+id/textView90"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/textView90"
                android:layout_alignParentEnd="true">
                <RadioButton
                    android:id="@+id/light3type1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="type1"/>
                <RadioButton
                    android:layout_gravity="right"
                    android:id="@+id/light3type2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="type2"/>
                <RadioButton
                    android:id="@+id/light3type3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="type3"/>
                <RadioButton
                    android:id="@+id/light3type4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="type4"/>
            </RadioGroup>
        </LinearLayout>
    </HorizontalScrollView>
</RelativeLayout>
