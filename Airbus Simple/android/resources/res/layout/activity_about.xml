<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:src="@drawable/about_page_bg"
        android:scaleType="centerCrop"
        android:layout_alignParentTop="true"
        android:layout_marginStart="0dp"
        android:layout_alignParentStart="true"/>
    <android.support.v7.widget.Toolbar
        android:id="@+id/about_toolbar"
        android:background="#5f000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        style="@style/MenuStyle"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#ffffff"
        android:gravity="bottom"
        android:id="@+id/textView30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="416dp"
        android:text="Developped by Lotus Inc. "
        android:layout_below="@+id/textView29"
        android:layout_marginStart="-49dp"
        android:layout_alignStart="@+id/textView34"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/textView32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:text="Smart Home Group U.S.A"
        android:layout_above="@+id/textView33"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/textView33"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-74dp"
        android:text="Copyright @2020 SmartG4. AllRightsReserved."
        android:layout_above="@+id/textView31"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@drawable/textcolorstyle"
        android:id="@+id/textView40"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="Check for Updates"
        android:layout_below="@+id/textView35"
        android:layout_centerHorizontal="true"
        android:onClick="updates"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@drawable/textcolorstyle"
        android:id="@+id/textView41"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:text="User Manual"
        android:layout_below="@+id/textView40"
        android:layout_centerHorizontal="true"
        android:onClick="help"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/textView31"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="231dp"
        android:text="G4 AIR BUS"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:id="@+id/textView107"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/update"
        android:layout_toRightOf="@+id/textView40"
        android:layout_above="@+id/textView32"
        android:layout_toEndOf="@+id/textView40"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="#ffffff"
        android:id="@+id/textView29"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="ABOUT"
        android:layout_below="@+id/about_toolbar"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/textView35"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ReleaseDate：28 July.2017"
        android:layout_below="@+id/textView34"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#a9a9a9"
        android:gravity="center"
        android:id="@+id/textView34"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-212dp"
        android:text="Ver 1.01"
        android:layout_above="@+id/textView32"
        android:layout_marginEnd="147dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
