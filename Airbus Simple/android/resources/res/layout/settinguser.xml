<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/bg_style">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <Button
            android:textSize="@dimen/text_title_size"
            android:textColor="@color/color_black"
            android:id="@+id/user_cancel"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/back"
            android:layout_weight="1"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_camera_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/user_setting"
            android:shadowColor="@color/color_shadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:layout_centerInParent="true"/>
        <Button
            android:textSize="@dimen/text_title_size"
            android:textColor="@color/color_white"
            android:id="@+id/user_ok"
            android:background="@drawable/btnselector"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_marginRight="10dp"
            android:text="@string/done"
            android:layout_weight="1"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/linearLayout3"
                android:background="@drawable/background_white_corner"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp">
                <TextView
                    android:textSize="@dimen/text_title_size"
                    android:textColor="@color/color_black"
                    android:gravity="center_vertical"
                    android:id="@+id/textView0"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/user_admin"/>
                <EditText
                    android:id="@+id/edit_name"
                    android:background="@drawable/edit_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:singleLine="true"
                    android:maxLength="64"/>
                <TextView
                    android:textSize="@dimen/text_title_size"
                    android:textColor="@color/color_black"
                    android:gravity="center_vertical"
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/password"/>
                <EditText
                    android:id="@+id/edit_pwd"
                    android:background="@drawable/edit_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:singleLine="true"
                    android:maxLength="64"
                    android:inputType="textPassword"/>
                <CheckBox
                    android:textColor="@color/color_black"
                    android:id="@+id/cbox_show_pwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/showpwd"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
