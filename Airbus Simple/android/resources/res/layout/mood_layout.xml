<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mooditem"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <com.shima.smartbushome.assist.SwipeLayout
            android:orientation="horizontal"
            android:id="@+id/moodswipe"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:minHeight="?android:attr/listPreferredItemHeight">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/moodlinear"
                android:layout_width="match_parent"
                android:layout_height="80dp">
                <ImageView
                    android:id="@+id/mood_image"
                    android:layout_width="0dp"
                    android:layout_height="79dp"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/mood_text"
                    android:layout_width="0dp"
                    android:layout_height="79dp"
                    android:layout_weight="3.6"
                    android:textAlignment="center"/>
                <CheckBox
                    android:layout_gravity="center"
                    android:id="@+id/mooddeletecb"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="79dp"
                    android:checked="false"
                    android:button="@drawable/checkbox_checked_style"
                    android:layout_weight="0.4"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="#d20001"
                android:layout_width="60dp"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/mood_delete"
                    android:layout_width="60dp"
                    android:layout_height="match_parent">
                    <ImageView
                        android:background="@drawable/ic_delete"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_centerInParent="true"/>
                </LinearLayout>
            </LinearLayout>
        </com.shima.smartbushome.assist.SwipeLayout>
    </LinearLayout>
</merge>
