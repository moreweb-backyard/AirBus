<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/bg_style">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        style="@style/top_bg_style">
        <Button
            android:textSize="@dimen/text_title_size"
            android:textColor="@color/color_black"
            android:id="@+id/back"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/back"
            android:layout_weight="1"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_camera_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/sdcard_schedule"
            android:shadowColor="@color/color_shadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:layout_centerInParent="true"/>
        <Button
            android:textSize="@dimen/text_title_size"
            android:textColor="@color/color_white"
            android:id="@+id/ok"
            android:background="@drawable/btnselector"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_marginRight="10dp"
            android:text="@string/done"
            android:layout_weight="1"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/linearLayout3"
                android:background="@drawable/background_white_corner"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp">
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_margin="5dp">
                    <TextView
                        android:textColor="@color/color_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sdcard_total"
                        android:layout_alignParentLeft="true"/>
                    <TextView
                        android:textColor="@color/color_black"
                        android:id="@+id/tv_sd_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0MB"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@color/color_grey"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_margin="5dp">
                    <TextView
                        android:textColor="@color/color_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sdcard_remain"
                        android:layout_alignParentLeft="true"/>
                    <TextView
                        android:textColor="@color/color_black"
                        android:id="@+id/tv_sd_remain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0MB"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@color/color_grey"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/color_black"
                        android:id="@+id/sdstate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/sdcard_state"
                        android:layout_centerVertical="true"/>
                    <Button
                        android:id="@+id/btn_format"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sdcard_format"
                        android:layout_alignParentRight="true"/>
                    <TextView
                        android:textColor="@color/color_black"
                        android:ellipsize="marquee"
                        android:id="@+id/tv_state"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_toLeftOf="@+id/btn_format"
                        android:layout_toRightOf="@+id/sdstate"
                        android:layout_centerVertical="true"
                        android:marqueeRepeatLimit="marquee_forever"/>
                </RelativeLayout>
                <ImageView
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@color/color_grey"/>
                <RelativeLayout
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/color_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sdcard_coverage"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"/>
                    <CheckBox
                        android:id="@+id/cbx_coverage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <ImageView
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@color/color_grey"/>
                <LinearLayout
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/color_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/sdcard_recordlength"/>
                    <EditText
                        android:id="@+id/edit_record_length"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="@string/sdcard_range"
                        android:maxLength="3"
                        android:digits="0123456789"
                        android:layout_weight="1"
                        android:inputType="number"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@color/color_grey"/>
                <RelativeLayout
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/color_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sdcard_recordtime"
                        android:layout_centerVertical="true"/>
                    <CheckBox
                        android:id="@+id/cbx_record_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:src="@color/color_grey"/>
                <RelativeLayout
                    android:id="@+id/rl_video_mode"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:textColor="@color/color_black"
                        android:id="@+id/tv_video_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/video_mode"
                        android:layout_centerVertical="true"/>
                    <CheckBox
                        android:id="@+id/iv_video_mode"
                        android:background="@drawable/choose_video_plan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@color/color_grey"/>
                <RelativeLayout
                    android:id="@+id/rl_plan_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp">
                    <RelativeLayout
                        android:id="@+id/rl_video_plan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/color_black"
                            android:id="@+id/tv_video_plan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/plan_video"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"/>
                        <com.pzj.ipcdemo.view.MyListView
                            android:id="@+id/lv_video_plan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:listSelector="@drawable/list_bgnull_selector"
                            android:cacheColorHint="#000000"
                            android:divider="@drawable/list_item_divider"
                            android:layout_below="@+id/tv_video_plan"/>
                        <RelativeLayout
                            android:id="@+id/rl_add_plan"
                            android:background="@drawable/userinfo_list_back_1"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="5dp"
                            android:layout_below="@+id/lv_video_plan">
                            <TextView
                                android:textColor="@color/color_black"
                                android:id="@+id/tv_add_plan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/add_plan_video"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"/>
                            <ImageView
                                android:background="@drawable/arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"/>
                        </RelativeLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rl_move_plan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_below="@+id/rl_video_plan">
                        <TextView
                            android:textColor="@color/color_black"
                            android:id="@+id/tv_move_plan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/move_video"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"/>
                        <com.pzj.ipcdemo.view.MyListView
                            android:id="@+id/lv_move_plan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:listSelector="@drawable/list_bgnull_selector"
                            android:cacheColorHint="#000000"
                            android:divider="@drawable/list_item_divider"
                            android:layout_below="@+id/tv_move_plan"/>
                        <RelativeLayout
                            android:id="@+id/rl_add_move_plan"
                            android:background="@drawable/userinfo_list_back_1"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="5dp"
                            android:layout_below="@+id/lv_move_plan">
                            <TextView
                                android:textColor="@color/color_black"
                                android:id="@+id/tv_add_move_plan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/add_move_video"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"/>
                            <ImageView
                                android:background="@drawable/arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"/>
                        </RelativeLayout>
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
