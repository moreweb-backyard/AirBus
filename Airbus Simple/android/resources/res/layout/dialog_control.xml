<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_up"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/play_up_bg_selector"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_down"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/play_down_bg_selector"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_left"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/play_left_bg_selector"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/iv_right"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/play_right_bg_selector"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="60dp">
        <ImageView
            android:id="@+id/iv_voice"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:src="@drawable/play_voice_bg_selector"
            android:scaleType="fitCenter"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_mic"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:src="@drawable/play_mic_bg_selector"
            android:scaleType="fitCenter"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
