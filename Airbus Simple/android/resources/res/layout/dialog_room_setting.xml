<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/popup_window_border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">
            <TextView
                android:textSize="17sp"
                android:textColor="#000"
                android:gravity="center"
                android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="Enter Room Info"/>
            <View
                android:background="#ccc"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:visibility="gone"
                    style="@style/wrap_layout">
                    <LinearLayout
                        android:id="@+id/layout_add_device"
                        android:padding="0dp"
                        android:layout_height="50dp"
                        style="@style/single_layout">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="-30dp"
                            android:text="add_device"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/wrap_layout">
                    <LinearLayout
                        android:padding="0dp"
                        android:layout_height="50dp"
                        style="@style/single_layout">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="name"
                            android:layout_weight="2"/>
                        <View
                            android:background="#ccc"
                            android:layout_width="0.3dp"
                            android:layout_height="match_parent"/>
                        <EditText
                            android:textColor="#000000"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/ed_zonename"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="4"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/wrap_layout">
                    <LinearLayout
                        android:padding="0dp"
                        android:layout_height="50dp"
                        style="@style/single_layout">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="orientation"
                            android:layout_weight="2"/>
                        <View
                            android:background="#ccc"
                            android:layout_width="0.3dp"
                            android:layout_height="match_parent"/>
                        <RadioGroup
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/rg_action"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="4">
                            <LinearLayout
                                android:gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <RadioButton
                                    android:id="@+id/rb_vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textColor="#000000"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="vertical"/>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <RadioButton
                                    android:id="@+id/rb_horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textColor="#000000"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="horizontal"/>
                            </LinearLayout>
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginBottom="8dp"
                    style="@style/wrap_layout">
                    <LinearLayout
                        android:padding="0dp"
                        android:layout_height="50dp"
                        style="@style/single_layout">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="picture"
                            android:layout_weight="2"/>
                        <View
                            android:background="#ccc"
                            android:layout_width="0.3dp"
                            android:layout_height="match_parent"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="4">
                            <LinearLayout
                                android:gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/iv_gallery"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/gallery"/>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/iv_camera"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/camera"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:background="#ccc"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp">
                    <TextView
                        android:textSize="17sp"
                        android:textColor="#2092f6"
                        android:gravity="center"
                        android:id="@+id/tv_cancel"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="cancel"
                        android:layout_weight="1"/>
                    <View
                        android:background="#ccc"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="#2092f6"
                        android:gravity="center"
                        android:id="@+id/tv_finish"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="complete"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
