<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ListView
            android:id="@+id/listView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:divider="#00ffffff"
            android:dividerHeight="5dp"
            android:layout_above="@+id/checkBox3"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>
        <SeekBar
            android:id="@+id/seekBar4"
            android:background="@drawable/media_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="50dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:max="100"
            android:layout_toRightOf="@+id/checkBox3"
            android:layout_alignTop="@+id/checkBox3"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
        <Button
            android:id="@+id/checkBox3"
            android:background="@drawable/play"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="5dp"
            android:button="@drawable/music_radio_play"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/textView5"
            android:background="@drawable/media_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:text="0%"
            android:layout_toLeftOf="@+id/checkBox3"
            android:layout_alignTop="@+id/seekBar4"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@+id/checkBox3"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</merge>
