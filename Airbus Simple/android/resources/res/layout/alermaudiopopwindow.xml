<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/trigger_audio_levelhigh"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/alerm_audio_levelhigh"/>
    <ImageView
        android:background="@drawable/toptitle"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:src="@color/color_line"/>
    <TextView
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/trigger_audio_levelmiddle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/alerm_audio_levelmiddle"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:src="@color/color_line"/>
    <TextView
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/trigger_audio_levellow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/alerm_audio_levellow"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:src="@color/color_line"/>
    <TextView
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/trigger_audio_levelforbid"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/alerm_audio_levelforbid"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:src="@color/color_line"/>
</LinearLayout>
