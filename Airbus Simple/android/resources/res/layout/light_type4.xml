<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lighttype4linear"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ltype4_icon"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:scaleType="centerInside"
                android:layout_weight="1"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/ltype4_remark"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:text="light"
                android:layout_weight="1.3"
                android:textAlignment="center"/>
            <Space
                android:id="@+id/sp"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="0.2"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/ltype4_state"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:text="OFF"
                android:layout_weight="0.7"
                android:textAlignment="center"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2">
                <Button
                    android:id="@+id/ltype4button"
                    android:background="@drawable/lighttype4_button"
                    android:layout_width="80dp"
                    android:layout_height="80dp"/>
            </LinearLayout>
            <CheckBox
                android:layout_gravity="center"
                android:id="@+id/ltype4_checkbox"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:checked="false"
                android:button="@drawable/checkbox_checked_style"
                android:layout_weight="0.7"/>
        </LinearLayout>
    </LinearLayout>
</merge>
