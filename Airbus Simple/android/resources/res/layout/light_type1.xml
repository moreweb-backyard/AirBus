<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <com.shima.smartbushome.assist.SwipeLayout
            android:orientation="horizontal"
            android:id="@+id/lighttype1swipe"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:minHeight="?android:attr/listPreferredItemHeight">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/type1linear"
                android:paddingRight="5dp"
                android:layout_width="match_parent"
                android:layout_height="80dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/imageView"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:scaleType="centerInside"
                    android:layout_weight="1"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/remark"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:text="light"
                    android:layout_weight="1.3"
                    android:textAlignment="center"/>
                <Space
                    android:id="@+id/sp"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="0.2"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/lightstate"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:text="OFF"
                    android:layout_weight="0.7"
                    android:textAlignment="center"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2">
                    <com.kyleduo.switchbutton.SwitchButton
                        android:layout_gravity="center"
                        android:id="@+id/switch2"
                        android:paddingLeft="10dp"
                        android:paddingTop="25dp"
                        android:paddingRight="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="80dp"
                        android:checked="false"
                        app:kswAnimationDuration="300"
                        app:kswBackDrawable="@drawable/ios_back_drawable"
                        app:kswBackMeasureRatio="1.4"
                        app:kswThumbDrawable="@drawable/ios_thumb_selector"
                        app:kswThumbMarginBottom="-8dp"
                        app:kswThumbMarginLeft="-5dp"
                        app:kswThumbMarginRight="-5dp"
                        app:kswThumbMarginTop="-2.5dp"/>
                </LinearLayout>
                <Space
                    android:id="@+id/sp2"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"/>
                <CheckBox
                    android:id="@+id/checkBox"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:checked="false"
                    android:button="@drawable/checkbox_checked_style"
                    android:layout_weight="0.7"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="#d20001"
                android:layout_width="60dp"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/lighttype1_delete"
                    android:layout_width="30dp"
                    android:layout_height="match_parent">
                    <ImageView
                        android:background="@drawable/ic_delete"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_centerInParent="true"/>
                </LinearLayout>
            </LinearLayout>
        </com.shima.smartbushome.assist.SwipeLayout>
    </LinearLayout>
</merge>
