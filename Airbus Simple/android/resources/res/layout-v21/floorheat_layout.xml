<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="30sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/tv_devicename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="FH:Name"
                android:textIsSelectable="false"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/layout_curtemper"
                android:background="@drawable/control_back_10"
                android:layout_width="150dp"
                android:layout_height="60dp"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/ac_home"/>
                <TextView
                    android:textSize="35sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/tv_curtemper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="N/A"
                    android:textAlignment="center"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <Button
                    android:textSize="25dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/bt_on"
                    android:background="@drawable/control_back_10"
                    android:layout_width="100dp"
                    android:layout_height="60dp"
                    android:layout_marginRight="40dp"
                    android:text="ON"/>
                <Button
                    android:textSize="25dp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/bt_off"
                    android:background="@drawable/control_back_10"
                    android:layout_width="100dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="40dp"
                    android:text="OFF"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_core"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Mode"
                        android:textIsSelectable="false"/>
                    <HorizontalScrollView
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <RadioGroup
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/rg_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">
                            <RadioButton
                                android:textColor="#ffffff"
                                android:id="@+id/rb_manual"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:text="Manual"/>
                            <RadioButton
                                android:textColor="#ffffff"
                                android:id="@+id/rb_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:text="Day"/>
                            <RadioButton
                                android:textColor="#ffffff"
                                android:id="@+id/rb_night"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:text="Night"/>
                            <RadioButton
                                android:textColor="#ffffff"
                                android:id="@+id/rb_away"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:text="Away"/>
                            <RadioButton
                                android:textColor="#ffffff"
                                android:id="@+id/rb_auto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:text="Timer"/>
                        </RadioGroup>
                    </HorizontalScrollView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Configure the mode temperature"
                        android:textIsSelectable="false"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/layout_manual"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Manual"
                            android:layout_weight="1"/>
                        <SeekBar
                            android:layout_gravity="center"
                            android:id="@+id/sb_manual"
                            android:background="@drawable/media_back"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:max="32"
                            android:layout_weight="4"
                            android:splitTrack="false"/>
                        <TextView
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/tv_manual"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="5°C"
                            android:layout_weight="0.5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/layout_day"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Day"
                            android:layout_weight="1"/>
                        <SeekBar
                            android:layout_gravity="center"
                            android:id="@+id/sb_day"
                            android:background="@drawable/media_back"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:max="32"
                            android:layout_weight="4"
                            android:splitTrack="false"/>
                        <TextView
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/tv_day"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="5°C"
                            android:layout_weight="0.5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/layout_night"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Night"
                            android:layout_weight="1"/>
                        <SeekBar
                            android:layout_gravity="center"
                            android:id="@+id/sb_night"
                            android:background="@drawable/media_back"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:max="32"
                            android:layout_weight="4"
                            android:splitTrack="false"/>
                        <TextView
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/tv_night"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="5°C"
                            android:layout_weight="0.5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/layout_away"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp">
                        <TextView
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Away"
                            android:layout_weight="1"/>
                        <SeekBar
                            android:layout_gravity="center"
                            android:id="@+id/sb_away"
                            android:background="@drawable/media_back"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:max="32"
                            android:layout_weight="4"
                            android:splitTrack="false"/>
                        <TextView
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/tv_away"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="5°C"
                            android:layout_weight="0.5"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="18sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Configure the time mode"
                    android:textIsSelectable="false"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <Button
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:id="@+id/bt_daytime"
                        android:background="@drawable/control_back_10"
                        android:layout_width="150dp"
                        android:layout_height="50dp"
                        android:layout_marginRight="30dp"
                        android:text="Day:08:30"/>
                    <Button
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:id="@+id/bt_nighttime"
                        android:background="@drawable/control_back_10"
                        android:layout_width="150dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="30dp"
                        android:text="Night:18:30"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
